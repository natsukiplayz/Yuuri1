@app.post("/api/upload-design")
async def upload_design(title: str = Form(...), file: UploadFile = File(...)):
    try:
        result = cloudinary.uploader.upload(file.file)
        image_url = result.get("secure_url")
        from bot.config import async_db
        await async_db.designs.insert_one({"title": title, "image_url": image_url})
        return {"status": "success", "url": image_url}
    except Exception as e:
        logging.error(f"Upload Error: {e}")
        raise HTTPException(status_code=500, detail="Upload failed")


@app.get("/api/get-designs")
async def get_designs():
    try:
        from bot.config import async_db
        cursor = async_db.designs.find().sort("_id", -1).limit(20)
        designs = await cursor.to_list(length=20)
        for d in designs:
            d["_id"] = str(d["_id"])
        return designs
    except Exception:
        return []


# ================= AUTO SAVE CHAT + BLOCK GUARD =================

async def save_chat_and_user(update: Update, context):
    user = update.effective_user
    message = update.effective_message
    chat = update.effective_chat
    if not user or not message or not chat:
        return

    user_db = get_user(user)

    if user.id != OWNER_ID and user_db.get("blocked"):
        is_private = chat.type == "private"
        is_command = message.text and message.text.startswith("/")
        if is_private or is_command:
            await message.reply_text("Sᴏʀʀʏ Bᴜᴛ Yᴏᴜ'ʀᴇ Bʟᴏᴄᴋᴇᴅ 😒")
        raise ApplicationHandlerStop

    db["chats"].update_one({"id": chat.id}, {"$set": {"type": chat.type, "title": getattr(chat, "title", None)}}, upsert=True)
    users.update_one({"id": user.id}, {"$set": {"name": user.first_name, "username": user.username.lower() if user.username else None}})


async def error_handler(update, context) -> None:
    print(f"⚠️ Telegram Error: {context.error}")
    if "Timed out" in str(context.error) or "httpx" in str(context.error):
        return


